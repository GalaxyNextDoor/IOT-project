# Database
DATABASE_URL=sqlite:///./zero_trust_iot.db

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default Admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ZeroTrust@2024!
DEFAULT_ADMIN_EMAIL=admin@zerotrust.local

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Risk Engine
RISK_QUARANTINE_THRESHOLD=90
RISK_RESTRICT_THRESHOLD=70
RISK_DECAY_RATE=1.0
RISK_DECAY_INTERVAL_SECONDS=60

# Simulator
SIMULATOR_TELEMETRY_INTERVAL=5
SIMULATOR_ENABLED=true
